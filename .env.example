GITHUB_TOKEN=
GEMINI_API_KEY=
AGENT_MODEL=gemini-2.5-pro
EXTRACT_MODEL=gemini-2.5-flash
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
TARGET_REPO=pallets/flask
MODULE_DEPTH=2
# Set to 1 to answer with canned, zero-network demo replies from the seed graph.
# Never enabled automatically: without GEMINI_API_KEY and without this, /ask returns an error.
DIG_OFFLINE=0
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
